# Это образец. Реальные значения проще задать на странице /setup,
# она сама создаст файл .env. Либо скопируйте этот файл в .env и заполните вручную:
#   cp .env.example .env

# База данных PostgreSQL. Значения по умолчанию совпадают с docker-compose.yml.
DATABASE_URL=postgresql+psycopg://kiberchekap:kiberchekap@localhost:5432/kiberchekap

# Адрес лендинга, откуда приходят заявки (для CORS). Через запятую, без пробелов.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Почта, с которой отправляются письма.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Отправитель писем.
SENDER_NAME=Киберчекап
SENDER_EMAIL=

# Адрес сайта, ставится ссылкой внутри писем. Пример: https://вашсайт.ру
SITE_URL=

# Логин и пароль для входа на страницу настройки.
ADMIN_LOGIN=
ADMIN_PASSWORD=
